# Copy this file to backend/.env. Never commit backend/.env or real credentials.
# Demo defaults are conservative: local database, redacted interaction logs, and disabled channels.
APP_ENV=development
APP_NAME=medical-agent
LOG_LEVEL=INFO
LOG_JSON=false
LOG_FILE_PATH=./logs/medical-agent.jsonl
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
# Interaction logs can contain sensitive patient text. Restrict file access in production.
INTERACTION_LOG_ENABLED=true
INTERACTION_LOG_FILE_PATH=./logs/interactions.jsonl
INTERACTION_LOG_INCLUDE_CONTENT=false
INTERACTION_LOG_MAX_CONTENT_CHARS=20000
INTERACTION_LOG_MAX_BYTES=20971520
INTERACTION_LOG_BACKUP_COUNT=30
DATABASE_URL=sqlite+aiosqlite:///./medical_agent.db
# Docker PostgreSQL local development (see docs/operations/postgres-migration.md):
# DATABASE_URL=postgresql+asyncpg://medical_agent:medical_agent_local@127.0.0.1:55432/medical_agent
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Development only: private-LAN browser origins. Production should use explicit HTTPS origins.
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2})(?::\d+)?$
ADMIN_API_TOKEN=
# Reserved for later object-storage migration; the current media service uses MEDIA_STORAGE_PATH.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=medical-agent
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me
LLM_PROVIDER=demo
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1024
LLM_ENABLE_THINKING=false
# Retry the primary model once before switching to the fallback API.
LLM_RETRY_COUNT=1
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=
FALLBACK_LLM_TIMEOUT_SECONDS=60
FALLBACK_LLM_MAX_TOKENS=1024
# FALLBACK_LLM_ENABLE_THINKING=false
HISTORY_MESSAGE_LIMIT=20
# Older messages are compressed in batches into same-conversation memory.
HISTORY_SUMMARY_BATCH_SIZE=8
HISTORY_SUMMARY_MAX_CHARS=3000
# Same-conversation image context. Historical images never cross conversation boundaries.
HISTORY_IMAGE_LIMIT=4
HISTORY_IMAGE_MAX_TOTAL_BYTES=8388608
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_MAX_TOKENS=1024
# VISION_ENABLE_THINKING=true
ASR_PROVIDER=disabled
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
ASR_LANGUAGE=
ASR_TIMEOUT_SECONDS=60
ASR_MAX_AUDIO_BYTES=10485760
# Cloud speech: admin > 运行总览 > 语音合成 > 配置 > 音色与播报.
# Protocol: openai-compatible, azure-speech, elevenlabs, volcengine, custom, or local-sherpa.
TTS_PROTOCOL=openai-compatible
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
# SiliconFlow CosyVoice2 preset: FunAudioLLM/CosyVoice2-0.5B:anna (short anna also accepted).
# Full custom / cloned voice IDs are forwarded unchanged.
TTS_TIMEOUT_SECONDS=30
# Enable only when the selected provider really streams raw signed 16-bit little-endian PCM.
TTS_STREAMING_ENABLED=false
TTS_STREAM_RESPONSE_FORMAT=pcm
TTS_STREAM_SAMPLE_RATE=24000
TTS_STREAM_CHANNELS=1
# Recommended low-latency Chinese cloud option:
# TTS_PROTOCOL=azure-speech
# TTS_BASE_URL=https://<azure-region>.tts.speech.microsoft.com
# TTS_API_KEY=<azure-speech-key>
# TTS_MODEL=Azure Neural TTS
# TTS_VOICE=zh-CN-XiaoxiaoNeural
# TTS_STREAMING_ENABLED=true
# ElevenLabs alternative: protocol=elevenlabs, base=https://api.elevenlabs.io,
# model=eleven_flash_v2_5, voice=<ElevenLabs voice ID>, streaming=true.
# Volcengine Doubao V3 (new console API Key):
# TTS_PROTOCOL=volcengine
# TTS_BASE_URL=https://openspeech.bytedance.com
# TTS_API_KEY=<volcengine-api-key>
# TTS_MODEL=seed-tts-2.0
# TTS_VOICE=<authorized-speaker-id>
# TTS_STREAMING_ENABLED=true
# Local CPU voice: install --extra local-tts and run scripts/setup_local_tts.py first.
TTS_LOCAL_MODEL_DIR=./data/tts/huayan
TTS_LOCAL_THREADS=2
TTS_LOCAL_SPEAKER_ID=0
# Generic JSON streaming adapter for a self-hosted or otherwise unsupported provider.
TTS_CUSTOM_PATH=/audio/speech
TTS_CUSTOM_AUTH_HEADER=Authorization
TTS_CUSTOM_AUTH_SCHEME=Bearer
TTS_CUSTOM_TEXT_FIELD=input
TTS_CUSTOM_MODEL_FIELD=model
TTS_CUSTOM_VOICE_FIELD=voice
TTS_CUSTOM_FORMAT_FIELD=response_format
TTS_CUSTOM_SPEED_FIELD=speed
MEDIA_STORAGE_PATH=./data/uploads
MEDIA_MAX_IMAGE_COUNT=4
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_TOTAL_BYTES=16777216
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=32
RERANKER_ENABLED=false
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=
RERANKER_TIMEOUT_SECONDS=30
RERANKER_CANDIDATE_K=12
KNOWLEDGE_DRAFT_LIMIT=5
PROMPT_DRAFT_LIMIT=5
RAG_ENABLED=false
RAG_TOP_K=4
RAG_MIN_SCORE=0.16
RAG_RELATIVE_SCORE=0.62
RAG_REQUIRE_MATCH=true
# WeCom intelligent bot API mode (WebSocket; no public callback URL required).
WECOM_BOT_ENABLED=false
WECOM_BOT_ID=
WECOM_BOT_SECRET=
WECOM_BOT_WS_URL=wss://openws.work.weixin.qq.com
# Empty means all direct-message users; use comma-separated enterprise user IDs to restrict access.
WECOM_BOT_ALLOWED_USER_IDS=
# Group chats are disabled by default to reduce accidental patient-data disclosure.
WECOM_BOT_ALLOW_GROUPS=false
WECOM_BOT_HEARTBEAT_SECONDS=30
WECOM_BOT_REPLY_INTERVAL_SECONDS=0.3
# WeChat Customer Service callback API (separate from the API-mode bot above).
WECHAT_KF_ENABLED=false
WECHAT_KF_CORP_ID=
WECHAT_KF_SECRET=
# Use OPEN_KFID for one account; OPEN_KF_IDS accepts additional comma-separated accounts.
WECHAT_KF_OPEN_KFID=
WECHAT_KF_OPEN_KF_IDS=
WECHAT_KF_CALLBACK_TOKEN=
WECHAT_KF_CALLBACK_AES_KEY=
WECHAT_KF_API_BASE_URL=https://qyapi.weixin.qq.com
# Empty means all customers. For trial runs, use comma-separated external_userid values.
WECHAT_KF_ALLOWED_EXTERNAL_USER_IDS=
WECHAT_KF_REQUEST_TIMEOUT_SECONDS=20
# Enterprise WeChat H5 JS-SDK. Required for native multi-image selection inside WeCom.
WECOM_H5_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
# Comma-separated exact H5 origins. Empty reuses CORS_ORIGINS.
WECOM_H5_ALLOWED_ORIGINS=
WECOM_H5_API_BASE_URL=https://qyapi.weixin.qq.com
WECOM_H5_REQUEST_TIMEOUT_SECONDS=15
# Reserved for a later Feishu adapter; not read by the current backend.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000
# Trusted certificate containing the phone-accessible LAN IP or domain.
# VITE_HTTPS_CERT_PATH=C:/path/to/dev-cert.pem
# VITE_HTTPS_KEY_PATH=C:/path/to/dev-key.pem

