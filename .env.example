APP_ENV=development
APP_NAME=medical-agent
LOG_LEVEL=INFO
LOG_JSON=false
LOG_FILE_PATH=./logs/medical-agent.jsonl
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
# Interaction logs can contain sensitive patient text. Restrict file access in production.
INTERACTION_LOG_ENABLED=true
INTERACTION_LOG_FILE_PATH=./logs/interactions.jsonl
INTERACTION_LOG_INCLUDE_CONTENT=false
INTERACTION_LOG_MAX_CONTENT_CHARS=20000
INTERACTION_LOG_MAX_BYTES=20971520
INTERACTION_LOG_BACKUP_COUNT=30
DATABASE_URL=sqlite+aiosqlite:///./medical_agent.db
# Docker PostgreSQL local development (see docs/operations/postgres-migration.md):
# DATABASE_URL=postgresql+asyncpg://medical_agent:medical_agent_local@127.0.0.1:55432/medical_agent
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Development only: private-LAN browser origins. Production should use explicit HTTPS origins.
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2})(?::\d+)?$
ADMIN_API_TOKEN=
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=medical-agent
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me
LLM_PROVIDER=demo
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1024
LLM_ENABLE_THINKING=false
HISTORY_MESSAGE_LIMIT=20
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_MAX_TOKENS=1024
# VISION_ENABLE_THINKING=true
ASR_PROVIDER=disabled
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
ASR_LANGUAGE=
ASR_TIMEOUT_SECONDS=60
ASR_MAX_AUDIO_BYTES=10485760
# Optional compatible cloud speech. Select the provider and voice ID in admin > 声音设置.
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=
# SiliconFlow CosyVoice2 preset: FunAudioLLM/CosyVoice2-0.5B:anna (short anna also accepted).
# Full custom / cloned voice IDs are forwarded unchanged.
TTS_TIMEOUT_SECONDS=30
MEDIA_STORAGE_PATH=./data/uploads
MEDIA_MAX_IMAGE_COUNT=4
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_TOTAL_BYTES=16777216
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_BATCH_SIZE=32
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=
RAG_ENABLED=false
RAG_TOP_K=4
RAG_MIN_SCORE=0.16
RAG_RELATIVE_SCORE=0.62
RAG_REQUIRE_MATCH=true
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_ENCRYPT_KEY=
FEISHU_VERIFICATION_TOKEN=
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000
# Trusted certificate containing the phone-accessible LAN IP or domain.
# VITE_HTTPS_CERT_PATH=C:/path/to/dev-cert.pem
# VITE_HTTPS_KEY_PATH=C:/path/to/dev-key.pem

