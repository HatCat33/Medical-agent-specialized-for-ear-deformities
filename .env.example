# =============================================================================
# 耳畸形科普问答智能体环境配置模板
# =============================================================================
#
# 使用方式：
#   1. 后端：复制本文件为 backend/.env。
#   2. 前端开发：将最下方 VITE_* 字段写入根目录 .env.local。
#   3. 服务器：保留服务器原有 backend/.env，不要用本地文件直接覆盖。
#
# 注意事项：
#   - 不要把真实 API Key、管理员令牌、数据库密码提交到 Git。
#   - 布尔值使用 true / false；时间通常以秒为单位；容量通常以字节为单位。
#   - 相对路径统一相对于 backend 目录解析，不受启动命令所在目录影响。
#   - 管理端保存的模型运行时配置存放在数据库中，优先级高于本文件；如修改
#     backend/.env 后未生效，请在管理端对相应模型执行“恢复默认”。
#   - 修改 backend/.env 后需要重启后端；修改 VITE_* 后需要重启开发服务或重新构建。

# =============================================================================
# 1. 应用与运行日志
# =============================================================================

# 环境标识。开发环境用 development，服务器建议使用 production。
APP_ENV=development
APP_NAME=medical-agent

# 日志级别：DEBUG、INFO、WARNING、ERROR。
LOG_LEVEL=INFO

# true 输出 JSON 到控制台，便于日志平台采集；本地开发通常使用 false。
LOG_JSON=false

# 运行日志根路径。实际按北京时间写入：
# logs/medical-agent/YYYY/MM/medical-agent-YYYY-MM-DD.jsonl
LOG_FILE_PATH=./logs/medical-agent.jsonl
LOG_MAX_BYTES=10485760
LOG_TIMEZONE=Asia/Shanghai

# 普通运行日志保留天数；0 表示不自动删除。当前建议保留 15 天。
LOG_RETENTION_DAYS=15

# =============================================================================
# 2. 用户交互日志
# =============================================================================

# 是否生成独立问答追踪日志。
INTERACTION_LOG_ENABLED=true

# 实际按日期写入：logs/interactions/YYYY/MM/interactions-YYYY-MM-DD.jsonl
INTERACTION_LOG_FILE_PATH=./logs/interactions.jsonl

# 是否保存用户输入和模型完整回答。包含患者内容，生产环境需谨慎开启。
INTERACTION_LOG_INCLUDE_CONTENT=false

# 单条内容最多保留的字符数；0 表示不保存正文内容。
INTERACTION_LOG_MAX_CONTENT_CHARS=20000

# 单日文件超过此大小后继续写入 -part002、-part003。
INTERACTION_LOG_MAX_BYTES=20971520
INTERACTION_LOG_TIMEZONE=Asia/Shanghai

# 交互日志保留天数；0 表示不自动删除。当前项目默认长期保留，需限制目录权限。
INTERACTION_LOG_RETENTION_DAYS=0

# =============================================================================
# 3. 数据库
# =============================================================================

# 本地轻量开发可使用 SQLite。
DATABASE_URL=sqlite+aiosqlite:///./medical_agent.db

# PostgreSQL 示例。本地 Compose 默认端口为 55432；服务器请填写真实账号和密码。
# DATABASE_URL=postgresql+asyncpg://medical_agent:replace-password@127.0.0.1:55432/medical_agent

# 以下连接池参数仅对 PostgreSQL 生效，并且是“每个 API 进程”各自一套。
# 单进程瞬时最大连接数 = DATABASE_POOL_SIZE + DATABASE_MAX_OVERFLOW。
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# 等待可用数据库连接的最长时间。
DATABASE_POOL_TIMEOUT_SECONDS=30

# 连接存活超过该时间后回收；0 表示不按时间回收。
DATABASE_POOL_RECYCLE_SECONDS=1800

# 取连接前检查连接是否仍有效，生产环境建议保持 true。
DATABASE_POOL_PRE_PING=true

# =============================================================================
# 4. Redis、缓存、幂等与限流
# =============================================================================

# Redis 不保存权威业务数据；不可用时多数缓存能力会降级，但 PostgreSQL 数据不受影响。
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:56379/0
REDIS_KEY_PREFIX=medical-agent
REDIS_CONNECT_TIMEOUT_SECONDS=1.5
REDIS_OPERATION_TIMEOUT_SECONDS=3

# Embedding 缓存 30 天；检索结果缓存 10 分钟。
EMBEDDING_CACHE_TTL_SECONDS=2592000
RETRIEVAL_CACHE_TTL_SECONDS=600

# TTS 音频可能包含敏感内容，默认不缓存。只有受控 Redis 才建议设置正数。
TTS_CACHE_TTL_SECONDS=0

# 单个访客在时间窗口内最多发起的聊天请求数；0 关闭请求限流。
CHAT_RATE_LIMIT_REQUESTS=30
CHAT_RATE_LIMIT_WINDOW_SECONDS=60

# 同一发送请求的幂等记录保存时间，用于避免重复点击或网络重试生成重复回答。
CHAT_IDEMPOTENCY_TTL_SECONDS=600

# =============================================================================
# 5. 模型并发与排队
# =============================================================================

# 文本模型并发上限；0 表示关闭该项并发准入控制。
MODEL_CONCURRENCY_LIMIT=20

# 文本请求在容量满时最多排队多久；超时后返回忙碌提示。
MODEL_CONCURRENCY_WAIT_SECONDS=15

# Redis 分布式并发租约时长，应覆盖一次完整的重试和备用模型链路。
MODEL_CONCURRENCY_LEASE_SECONDS=300

# 各能力分别排队，数值应小于或等于供应商账号实际并发额度。
VISION_CONCURRENCY_LIMIT=8
VISION_CONCURRENCY_WAIT_SECONDS=60
ASR_CONCURRENCY_LIMIT=8
ASR_CONCURRENCY_WAIT_SECONDS=60
TTS_CONCURRENCY_LIMIT=8
TTS_CONCURRENCY_WAIT_SECONDS=60
RERANKER_CONCURRENCY_LIMIT=12
RERANKER_CONCURRENCY_WAIT_SECONDS=30

# =============================================================================
# 6. 跨域与管理端安全
# =============================================================================

# 逗号分隔，不要在末尾加 /。服务器应明确填写患者端和管理端 HTTPS 域名。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# 仅供本地局域网开发。生产环境建议留空，并完全依赖上面的精确域名列表。
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2})(?::\d+)?$

# 管理端登录令牌。建议生成至少 32 字节随机值。
ADMIN_API_TOKEN=

# 敏感写操作的二次验证令牌，必须与 ADMIN_API_TOKEN 不同。
ADMIN_SECONDARY_TOKEN=

# 二次验证成功后在当前标签页保持有效的秒数，默认 15 分钟。
ADMIN_SECONDARY_AUTHORIZATION_TTL_SECONDS=900

# =============================================================================
# 7. 主文本模型与备用模型
# =============================================================================

# demo：不调用外部模型；openai-compatible：调用兼容 Chat Completions 的服务。
LLM_PROVIDER=demo
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1024

# 模型支持 thinking 参数时再开启；不支持时保持 false。
LLM_ENABLE_THINKING=false

# 主模型在首个输出片段前失败时的重试次数，范围 0-3。
LLM_RETRY_COUNT=1

# 备用模型建议使用不同厂商或独立服务实例，避免与主模型同时不可用。
# 三个核心字段同时填写后才会启用备用模型。
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=
FALLBACK_LLM_TIMEOUT_SECONDS=60
FALLBACK_LLM_MAX_TOKENS=1024
FALLBACK_LLM_ENABLE_THINKING=false

# =============================================================================
# 8. 会话上下文与滚动摘要
# =============================================================================

# 最近多少条消息保留原文。
HISTORY_MESSAGE_LIMIT=20

# 更早消息每累计多少条生成一次摘要，以及摘要最大字符数。
HISTORY_SUMMARY_BATCH_SIZE=8
HISTORY_SUMMARY_MAX_CHARS=3000

# 当前会话最多携带的历史图片数量和总大小，不会跨会话复用。
HISTORY_IMAGE_LIMIT=4
HISTORY_IMAGE_MAX_TOTAL_BYTES=8388608

# =============================================================================
# 9. 视觉模型
# =============================================================================

# 图片问答使用独立视觉模型。三个核心字段留空时不会把图片发给文本模型。
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_MAX_TOKENS=1024

# 仅在视觉服务明确支持 thinking 参数时取消注释。
# VISION_ENABLE_THINKING=false

# =============================================================================
# 10. 语音识别 ASR
# =============================================================================

# disabled 关闭；openai-compatible 调用 /audio/transcriptions 接口。
ASR_PROVIDER=disabled
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=

# 留空表示不强制语言；中文服务也可填写 zh。
ASR_LANGUAGE=
ASR_TIMEOUT_SECONDS=60
ASR_MAX_AUDIO_BYTES=10485760

# =============================================================================
# 11. 语音合成 TTS
# =============================================================================

# 支持：openai-compatible、azure-speech、elevenlabs、volcengine、custom。
TTS_PROTOCOL=openai-compatible
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=

# 填写供应商真实音色 ID；自定义或克隆音色 ID 会原样转发。
TTS_VOICE=
TTS_TIMEOUT_SECONDS=30

# 只有供应商接口真正支持当前适配器的流式音频时才开启。
TTS_STREAMING_ENABLED=false
TTS_STREAM_RESPONSE_FORMAT=pcm
TTS_STREAM_SAMPLE_RATE=24000
TTS_STREAM_CHANNELS=1

# Azure Speech 示例：
# TTS_PROTOCOL=azure-speech
# TTS_BASE_URL=https://<region>.tts.speech.microsoft.com
# TTS_API_KEY=<azure-speech-key>
# TTS_MODEL=Azure Neural TTS
# TTS_VOICE=zh-CN-XiaoxiaoNeural
# TTS_STREAMING_ENABLED=true

# ElevenLabs Flash 示例：
# TTS_PROTOCOL=elevenlabs
# TTS_BASE_URL=https://api.elevenlabs.io
# TTS_API_KEY=<elevenlabs-api-key>
# TTS_MODEL=eleven_flash_v2_5
# TTS_VOICE=<voice-id>
# TTS_STREAMING_ENABLED=true

# 火山引擎豆包语音示例。音色必须已在当前账号授权，并与模型资源版本匹配。
# TTS_PROTOCOL=volcengine
# TTS_BASE_URL=https://openspeech.bytedance.com
# TTS_API_KEY=<volcengine-api-key>
# TTS_MODEL=seed-tts-2.0
# TTS_VOICE=<authorized-speaker-id>
# TTS_STREAMING_ENABLED=true

# custom 协议字段映射。普通供应商无需修改。
TTS_CUSTOM_PATH=/audio/speech
TTS_CUSTOM_AUTH_HEADER=Authorization
TTS_CUSTOM_AUTH_SCHEME=Bearer
TTS_CUSTOM_TEXT_FIELD=input
TTS_CUSTOM_MODEL_FIELD=model
TTS_CUSTOM_VOICE_FIELD=voice
TTS_CUSTOM_FORMAT_FIELD=response_format
TTS_CUSTOM_SPEED_FIELD=speed

# =============================================================================
# 12. 图片与媒体文件
# =============================================================================

# 私有上传目录，不应直接暴露为 Nginx 静态目录。
MEDIA_STORAGE_PATH=./data/uploads

# 单次最多 4 张；单张 5 MiB；总计 16 MiB。
MEDIA_MAX_IMAGE_COUNT=4
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_MAX_TOTAL_BYTES=16777216

# =============================================================================
# 13. Embedding、Rerank 与 RAG
# =============================================================================

# Embedding 使用 OpenAI-compatible embeddings 接口。三个字段都填写后启用。
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# 供应商允许指定维度时取消注释并填写整数；不需要时保持未定义。
# EMBEDDING_DIMENSIONS=1024
EMBEDDING_TIMEOUT_SECONDS=60

# 离线知识向量批次大小。
EMBEDDING_BATCH_SIZE=32

# 合并短时间内的在线查询，减少上游请求数。
EMBEDDING_QUERY_BATCH_SIZE=25
EMBEDDING_QUERY_BATCH_WAIT_MS=20

# 阿里云百炼示例：
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=<dashscope-api-key>
# EMBEDDING_MODEL=qwen3.7-text-embedding-flash
# EMBEDDING_DIMENSIONS=1024

# Rerank 需要 enabled=true 且三个核心字段全部填写。
RERANKER_ENABLED=false
RERANKER_BASE_URL=
RERANKER_API_KEY=
RERANKER_MODEL=
RERANKER_TIMEOUT_SECONDS=30

# 送入 Rerank 的候选数量，应不小于 RAG_TOP_K。
RERANKER_CANDIDATE_K=12

# 管理端最多同时保留的草稿数。
KNOWLEDGE_DRAFT_LIMIT=3
PROMPT_DRAFT_LIMIT=3
ANNOUNCEMENT_DRAFT_LIMIT=3

# 是否启用患者回答知识检索。
RAG_ENABLED=false

# 最终召回数量、绝对最低分、相对最高分阈值。
RAG_TOP_K=4
RAG_MIN_SCORE=0.16
RAG_RELATIVE_SCORE=0.62

# true：没有合格知识时不允许通用模型自由补答。
RAG_REQUIRE_MATCH=true

# =============================================================================
# 14. 企业微信智能机器人（WebSocket API 模式）
# =============================================================================

# 此模式不需要公网回调地址。
WECOM_BOT_ENABLED=false
WECOM_BOT_ID=
WECOM_BOT_SECRET=
WECOM_BOT_WS_URL=wss://openws.work.weixin.qq.com

# 留空允许所有单聊用户；试用阶段可填写逗号分隔的企业用户 ID 白名单。
WECOM_BOT_ALLOWED_USER_IDS=

# 群聊默认关闭，避免患者信息意外出现在群聊。
WECOM_BOT_ALLOW_GROUPS=false
WECOM_BOT_HEARTBEAT_SECONDS=30
WECOM_BOT_REPLY_INTERVAL_SECONDS=0.3

# =============================================================================
# 15. 微信客服（加密回调 + 增量拉取）
# =============================================================================

WECHAT_KF_ENABLED=false
WECHAT_KF_CORP_ID=
WECHAT_KF_SECRET=

# 单客服账号填 OPEN_KFID；多个账号可在 OPEN_KF_IDS 继续用逗号分隔补充。
WECHAT_KF_OPEN_KFID=
WECHAT_KF_OPEN_KF_IDS=

# 必须与企业微信后台回调配置完全一致。
WECHAT_KF_CALLBACK_TOKEN=
WECHAT_KF_CALLBACK_AES_KEY=
WECHAT_KF_API_BASE_URL=https://qyapi.weixin.qq.com

# 留空允许全部客户；测试阶段可填写逗号分隔的 external_userid 白名单。
WECHAT_KF_ALLOWED_EXTERNAL_USER_IDS=
WECHAT_KF_REQUEST_TIMEOUT_SECONDS=20

# =============================================================================
# 16. 企业微信内嵌 H5 JS-SDK
# =============================================================================

# 用于企业微信内原生多图选择。企业微信后台还必须配置可信域名、网页授权域名
# 和 JS-SDK 域名；只填写下面变量并不能替代后台域名配置。
WECOM_H5_ENABLED=false
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=

# 逗号分隔的精确 Origin，例如 https://medical.example.com；不要包含路径和末尾 /。
# 留空时复用 CORS_ORIGINS。
WECOM_H5_ALLOWED_ORIGINS=
WECOM_H5_API_BASE_URL=https://qyapi.weixin.qq.com
WECOM_H5_REQUEST_TIMEOUT_SECONDS=15

# =============================================================================
# 17. 前端 Vite 配置（写入项目根目录 .env.local）
# =============================================================================

# 浏览器请求 API 的相对前缀。生产环境通常由同域 Nginx 反向代理。
VITE_API_BASE_URL=/api/v1

# 仅用于本地 Vite 开发代理，不会写入后端配置。
VITE_BACKEND_PROXY_TARGET=http://127.0.0.1:8000
